{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "state",
    "freshness_hours",
    "required_groups",
    "required_certificates",
    "allow_rotation",
    "policy_id",
    "purpose",
    "category_ids",
    "item_kind",
    "rules"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "exact_identity",
        "same_price_competitor",
        "functional_substitute"
      ]
    },
    "category_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "item_kind": {
      "enum": [
        "main",
        "accessory"
      ]
    },
    "state": {
      "enum": [
        "draft",
        "shadow",
        "active"
      ]
    },
    "freshness_hours": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "required_groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_certificates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allow_rotation": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "operator",
          "unit",
          "required",
          "tolerance",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "eq",
              "min",
              "max",
              "range",
              "set"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "const": true
          },
          "tolerance": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "value": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    }
  }
}
