# Copy to docker/.env and choose fresh local secrets before starting.
POSTGRES_PASSWORD=replace-with-a-local-secret
PREFECT_AUTH_STRING=operator:replace-with-a-local-secret
PREFECT_HOST_PORT=4200
NARA_CONTROL_MEMORY=768m
NARA_WORKER_MEMORY=2g
NARA_REDIS_MEMORY=512m
NARA_REDIS_MAXMEMORY=128mb
NARA_DISPATCH_ENABLED=false
NARA_SOURCE_ENABLED=false
NARA_PRICE_DOMAIN_JSON=

# Optional web deployment: docker compose -f compose.web.yaml up -d --build
NARA_WEB_BIND=127.0.0.1
NARA_WEB_PORT=8080
NARA_WEB_HOSTS=localhost,127.0.0.1
